{
    "name": "vendor/colnect-api",
    "description": "A lightweight Saloon SDK for the Colnect API",
    "type": "library",
    "require": {
        "php": "^8.2",
        "saloonphp/saloon": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "*",
        "infection/infection": "*",
        "pcov/clobber": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Vendor\\ColnectApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\ColnectApi\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "audit": {
            "block-insecure": false
        },
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src tests --level 9",
        "mutate": "infection --show-mutations"
    }
}
