{
    "name": "vendor/colnect-api",
    "description": "A lightweight Saloon SDK for the Colnect API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "saloonphp/saloon": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "infection/infection": "^0.29"
    },
    "autoload": {
        "psr-4": {
            "Vendor\\ColnectApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\ColnectApi\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "audit": {
            "block-insecure": true
        },
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse src tests --level 9",
        "mutate": "vendor/bin/infection --show-mutations --coverage=build/coverage"
    }
}
