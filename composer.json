{
    "name": "vendor/colnect-api",
    "description": "A lightweight Saloon SDK for the Colnect API",
    "type": "library",
    "require": {
        "php": "^8.2",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.1",
        "infection/infection": "^0.32.7"
    },
    "autoload": {
        "psr-4": {
            "Vendor\\ColnectApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\ColnectApi\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
